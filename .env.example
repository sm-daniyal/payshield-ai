# PayShield AI Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- PayPal Sandbox Credentials ---
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# --- Razorpay Test Credentials (optional second payment rail) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- Payment Provider Selector: "paypal" | "razorpay" ---
PAYMENT_PROVIDER=paypal

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
COST_OPTIMAL_THRESHOLD=0.40
DISPUTE_FILING_FEE_USD=15.00

# --- Database ---
DATABASE_URL=sqlite:///./payshield_audit.db
