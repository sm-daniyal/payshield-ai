{
  "info": {
    "name": "PayShield AI — PayPal & Risk Radar Suite",
    "_postman_id": "b3e0c7a1-5d29-410c-8e2b-f1a2384a9e55",
    "description": "Official Postman Collection for PayShield AI (PayPal AI Hackathon 2026). Features automated test assertions verifying zero-hallucination SHAP additivity seals, deterministic policy boundaries, and PayPal dispute economics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health check returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Service identifier is payshield-ai', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.service).to.eql('payshield-ai');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": ["{{base_url}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "2. Pre-Capture Risk Evaluation (/api/v1/evaluate)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Evaluation returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Grounded SHAP Additivity Seal Verified (delta < 1e-4)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.additivity_verification.verified).to.be.true;",
              "    pm.expect(jsonData.additivity_verification.delta).to.be.below(0.0001);",
              "});",
              "pm.test('Decision Action is strictly bounded', function () {",
              "    var jsonData = pm.response.json();",
              "    var validActions = ['ALLOW', 'ALLOW_WITH_MONITORING', 'STEP_UP_VERIFICATION', 'BLOCK_AND_FLAG_DISPUTE'];",
              "    pm.expect(validActions).to.include(jsonData.decision.action);",
              "});",
              "pm.test('Contains 7-dimensional SHAP feature attributions', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.shap_contributions.length).to.eql(7);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transaction_id\": \"ORD-POSTMAN-VERIFIED-01\",\n  \"amount_usd\": 150.00,\n  \"buyer_email\": \"postman.test@example.com\",\n  \"buyer_country\": \"US\",\n  \"shipping_country\": \"US\",\n  \"ip_country\": \"US\",\n  \"buyer_currency\": \"USD\",\n  \"mid_market_rate_to_usd\": 1.0,\n  \"actual_rate_to_usd\": 1.0,\n  \"paypal_account_age_days\": 400,\n  \"paypal_account_verified\": true,\n  \"event_timestamp\": \"2026-10-13T15:30:00Z\",\n  \"history\": {\n    \"amounts\": [140.0, 150.0],\n    \"timestamps\": [\"2026-10-10T10:00:00Z\"],\n    \"dispute_count\": 0\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/evaluate",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "evaluate"]
        }
      }
    },
    {
      "name": "3. PayPal Order Webhook Ingestion",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Webhook processed successfully', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('PROCESSED');",
              "    pm.expect(jsonData.pipeline).to.eql('RISK_RADAR');",
              "});",
              "pm.test('Tamper-evident SHA-256 audit hash created', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.audit_hash.length).to.eql(64);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"WH-ORDER-EVT-01\",\n  \"event_type\": \"CHECKOUT.ORDER.APPROVED\",\n  \"resource\": {\n    \"id\": \"ORD-PAYPAL-WH-77\",\n    \"amount\": { \"value\": \"95.00\", \"currency_code\": \"USD\" },\n    \"payer\": { \"email_address\": \"webhook_payer@sandbox.paypal.com\" }\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/paypal/webhook",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "paypal", "webhook"]
        }
      }
    },
    {
      "name": "4. PayPal Dispute Webhook (Autonomous Recovery)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Dispute webhook routed to Autonomous Recovery', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('PROCESSED');",
              "    pm.expect(jsonData.pipeline).to.eql('DISPUTE_RECOVERY');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"WH-DSP-EVT-02\",\n  \"event_type\": \"CUSTOMER.DISPUTE.CREATED\",\n  \"resource\": {\n    \"dispute_id\": \"PP-D-POSTMAN-88\",\n    \"dispute_amount\": { \"value\": \"180.00\", \"currency_code\": \"USD\" },\n    \"disputed_transactions\": [{ \"seller_transaction_id\": \"TXN-ORIG-88\" }]\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/paypal/webhook",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "paypal", "webhook"]
        }
      }
    },
    {
      "name": "5. Dispute ROI Evaluation (PayShield Equation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Dispute evaluation returns positive net recovery', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.expected_net_recovery).to.be.above(0);",
              "    pm.expect(jsonData.action).to.eql('PROCEED_DIRECT_DISPUTE');",
              "});",
              "pm.test('Evidence dossier is structured and compiled', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.evidence_dossier).to.include('PAYSHIELD AI EVIDENCE DOSSIER');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dispute_id\": \"PP-D-EVAL-55\",\n  \"transaction_id\": \"TXN-REF-55\",\n  \"dispute_amount_usd\": 165.00,\n  \"dispute_reason\": \"MERCHANDISE_OR_SERVICE_NOT_RECEIVED\",\n  \"has_carrier_delivery_proof\": true,\n  \"has_avs_cvv_match\": true,\n  \"buyer_prior_disputes\": 0,\n  \"has_customer_chat_history\": true,\n  \"tracking_number\": \"9400111899562537684000\",\n  \"carrier_name\": \"USPS\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/disputes/evaluate",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "disputes", "evaluate"]
        }
      }
    },
    {
      "name": "6. Query Transaction Audit Log",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Audit log returns historical records array', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/audit/transactions",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "audit", "transactions"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ]
}
